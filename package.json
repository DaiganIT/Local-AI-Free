{
  "name": "local-ai-free",
  "version": "0.1.0",
  "private": true,
  "description": "A relay-based system that lets you chat with local AI models for free, from any device",
  "license": "PolyForm-Noncommercial-1.0.0",
  "workspaces": [
    "server",
    "llm-host",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:host": "npm run dev --workspace=llm-host",
    "dev:client": "npm run dev --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:host": "npm run build --workspace=llm-host",
    "build:client": "npm run build --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:host": "npm run test --workspace=llm-host",
    "test:client": "npm run test --workspace=client",
    "dev": "npm-run-all --parallel dev:server dev:host dev:client",
    "test": "npm run test:server && npm run test:host && npm run test:client"
  },
  "devDependencies": {
    "npm-run-all2": "^8.0.4"
  }
}
